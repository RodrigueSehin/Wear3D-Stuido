# Copier ce fichier en `.env` à la racine du dépôt (ignoré par git).
# Il est lu par apps/web (next.config.ts) et par apps/worker.
# Projet Supabase en ligne : Dashboard > Project Settings > API.

# --- Public (exposé au navigateur) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Clé publique (sb_publishable_... ou ancienne clé anon)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Serveur uniquement (jamais préfixé NEXT_PUBLIC_) ---
# Utilisée uniquement par les webhooks et le worker (CDC S-02).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=

# Stockage objet (Cloudflare R2) — phase 5
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=wear3d-assets

# IA — phase 7
ANTHROPIC_API_KEY=
AI_IMAGE_PROVIDER=mock

# Paiement — phase 8
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MOBILE_MONEY_PROVIDER=mock

# Observabilité — phase 8
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_CONTACT_EMAIL=
